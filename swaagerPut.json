		"/Ecm/Documents": {
			"post": {
				"tags": ["document"],
				"x-k2-entityName": "EcmDocumentDTO",
				"x-k2-displayName": "Upload Document",
				"x-k2-description": "Uploads a new document to the system using EcmDocumentDTO. This method is associated with EcmDocumentDTO for Nintex SmartObject generation, ensuring data is passed to the API as a DTO.",
				"summary": "Upload a document",
				"description": "Upload a new document to the system using EcmDocumentDTO for data transfer to the API. This endpoint creates a new document and is associated with EcmDocumentDTO for Nintex SmartObject generation.",
				"operationId": "uploadDocument",
