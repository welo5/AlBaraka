					"description": "Passport number of the customer"
				},
				"nameAr": {
					"type": "string",
					"maxLength": 200,
					"minLength": 1,
					"example": "محمد أحمد",
					"description": "Customer name in Arabic"
				},
				"nameEn": {
					"type": "string",
					"maxLength": 200,
					"minLength": 0,
					"example": "Mohamed Ahmed",
					"description": "Customer name in English"
				},
				"dob": {
					"type": "string",
					"format": "date",
					"example": "1990-01-01",
					"description": "Date of birth (YYYY-MM-DD)"
				},
				"gender": {
					"type": "string",
					"enum": ["male", "female"],
					"example": "male",
					"description": "Gender of the customer (male or female)"
				},
				"address": {
					"type": "string",
					"maxLength": 400,
					"minLength": 0,
					"example": "123 Main St, City",
					"description": "Customer address"
				},
				"mobile": {
					"type": "string",
					"maxLength": 20,
					"minLength": 1,
					"example": "+201234567890",
					"description": "Customer mobile number"
				},
				"email": {
					"type": "string",
					"maxLength": 200,
					"minLength": 0,
					"format": "email",
					"example": "mohammed@example.com",
					"description": "Customer email address"
				},
				"branchCode": {
					"type": "string",
					"maxLength": 10,
					"minLength": 1,
					"example": "BR001",
					"description": "Branch code"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time",
					"example": "2025-08-20T11:38:45.184Z",
					"description": "Creation timestamp (optional, typically set by the server)"
				},
				"accounts": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/CoreAccountDTO"
					},
					"description": "List of accounts associated with the customer (DTO)"
				}
			},
			"xml": {
				"name": "CoreCustomerDTO"
			},
			"description": "Data Transfer Object for customer operations, used for API input/output and Nintex SmartObject generation"
		},
		"EcmDocument": {
			"type": "object",
			"required": ["docType", "fileName", "folderId", "requestId"],
			"properties": {
				"documentId": {
					"type": "string",
					"format": "uuid",
					"description": "Unique identifier for the document"
				},
				"folderId": {
					"type": "string",
					"format": "uuid",
					"description": "ID of the folder containing the document"
				},
				"folder": {
					"$ref": "#/definitions/EcmFolder",
					"description": "Reference to the associated folder"
				},
				"requestId": {
					"type": "string",
					"maxLength": 50,
					"minLength": 0,
					"example": "REQ001",
					"description": "Request ID associated with the document"
				},
				"docType": {
					"type": "string",
					"maxLength": 50,
					"minLength": 0,
					"enum": ["identity", "proof_of_income", "bank_statement", "contract", "other"],
					"description": "Type of document"
				},
				"fileName": {
					"type": "string",
					"maxLength": 255,
					"minLength": 0,
