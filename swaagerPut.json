	"schemes": ["http"],
	"paths": {
		"/Aml": {
			"post": {
				"tags": ["aml"],
				"x-k2-entityName": "AmlScreeningDTO",
				"x-k2-displayName": "Create AML Screening",
				"x-k2-description": "Creates a new AML screening record using AmlScreeningDTO. This method is associated with AmlScreeningDTO for Nintex SmartObject generation, ensuring data is passed to the API as a DTO.",
				"summary": "Create a new AML screening",
				"description": "Perform AML screening for a customer using AmlScreeningDTO for data transfer to the API. This endpoint creates a new AML screening record and is associated with AmlScreeningDTO for Nintex SmartObject generation.",
				"operationId": "createAmlScreening",
				"consumes": ["application/json"],
				"produces": ["application/json"],
				"parameters": [
					{
						"in": "body",
						"name": "body",
						"description": "AML screening DTO object to create",
						"required": true,
						"schema": {
							"$ref": "#/definitions/AmlScreeningDTO"
						}
					}
				],
				"responses": {
					"201": {
						"description": "AML screening created successfully",
						"schema": {
							"$ref": "#/definitions/AmlScreeningDTO"
						}
					},
					"400": {
						"description": "Invalid input",
						"schema": {
							"$ref": "#/definitions/Error"
						}
					},
					"405": {
						"description": "Validation exception",
						"schema": {
							"$ref": "#/definitions/Error"
						}
					}
				},
				"security": [
					{
						"banking_auth": ["write:aml", "read:aml"]
					}
				]
			}
		},
		"/CoreAccount": {
			"post": {
				"tags": ["account"],
				"x-k2-entityName": "CoreAccountDTO",
				"x-k2-displayName": "Create Account",
				"x-k2-description": "Creates a new bank account using CoreAccountDTO. This method is associated with CoreAccountDTO for Nintex SmartObject generation, ensuring data is passed to the API as a DTO.",
				"summary": "Create a new account",
				"description": "Create a new bank account using CoreAccountDTO for data transfer to the API. This endpoint creates a new account and is associated with CoreAccountDTO for Nintex SmartObject generation.",
				"operationId": "createAccount",
				"consumes": ["application/json"],
				"produces": ["application/json"],
				"parameters": [
					{
						"in": "body",
						"name": "body",
						"description": "Account DTO object to create",
						"required": true,
						"schema": {
							"$ref": "#/definitions/CoreAccountDTO"
						}
					}
				],
				"responses": {
					"201": {
						"description": "Account created successfully",
						"schema": {
							"$ref": "#/definitions/CoreAccountDTO"
						}
