	"securityDefinitions": {
		"banking_auth": {
			"type": "oauth2",
			"authorizationUrl": "http://el-barka.runasp.net/oauth/dialog",
			"flow": "implicit",
			"scopes": {
				"write:aml": "modify AML screening records",
				"read:aml": "read AML screening records",
				"write:accounts": "modify accounts in your system",
				"read:accounts": "read your accounts",
				"write:customers": "modify customer records",
				"read:customers": "read customer records",
				"write:documents": "modify documents",
				"read:documents": "read documents"
			}
		},
		"api_key": {
			"type": "apiKey",
			"name": "api_key",
			"in": "header"
		}
	},
	"definitions": {
		"AmlScreening": {
			"type": "object",
			"required": ["riskLevel", "riskScore"],
			"properties": {
				"screeningId": {
					"type": "string",
					"format": "uuid",
					"description": "Unique identifier for the AML screening"
				},
				"nationalID": {
					"type": "string",
					"maxLength": 14,
					"minLength": 0,
					"description": "National ID of the customer"
				},
				"passportNo": {
					"type": "string",
					"maxLength": 30,
					"minLength": 0,
					"description": "Passport number of the customer"
				},
				"nameAr": {
					"type": "string",
					"maxLength": 200,
					"minLength": 0,
					"description": "Customer name in Arabic"
				},
				"nameEn": {
					"type": "string",
					"maxLength": 200,
					"minLength": 0,
					"description": "Customer name in English"
				},
				"riskScore": {
					"type": "integer",
					"format": "int32",
					"description": "Risk score from AML screening"
				},
				"riskLevel": {
					"type": "string",
					"maxLength": 10,
					"minLength": 0,
					"enum": ["low", "medium", "high"],
					"description": "Risk level from AML screening"
				},
				"hitsCount": {
					"type": "integer",
					"format": "int32",
					"description": "Number of hits in AML screening"
				},
				"performedAt": {
					"type": "string",
					"format": "date-time",
					"description": "Timestamp of when the screening was performed"
				}
			},
			"xml": {
				"name": "AmlScreening"
			}
		},
		"AmlScreeningDTO": {
			"type": "object",
			"required": ["riskLevel", "riskScore"],
			"properties": {
				"screeningId": {
					"type": "string",
					"format": "uuid",
					"description": "Unique identifier for the AML screening"
				},
				"nationalID": {
					"type": "string",
					"maxLength": 14,
					"minLength": 0,
					"description": "National ID of the customer"
				},
				"passportNo": {
					"type": "string",
					"maxLength": 30,
					"minLength": 0,
					"description": "Passport number of the customer"
				},
				"nameAr": {
					"type": "string",
					"maxLength": 200,
					"minLength": 0,
					"description": "Customer name in Arabic"
				},
				"nameEn": {
					"type": "string",
					"maxLength": 200,
					"minLength": 0,
					"description": "Customer name in English"
				},
				"riskScore": {
					"type": "integer",
					"format": "int32",
					"description": "Risk score from AML screening"
				},
				"riskLevel": {
					"type": "string",
					"maxLength": 10,
					"minLength": 0,
					"enum": ["low", "medium", "high"],
					"description": "Risk level from AML screening"
				},
				"hitsCount": {
					"type": "integer",
					"format": "int32",
					"description": "Number of hits in AML screening"
				},
				"performedAt": {
					"type": "string",
					"format": "date-time",
					"description": "Timestamp of when the screening was performed"
				}
			},
			"xml": {
				"name": "AmlScreeningDTO"
			},
			"description": "Data Transfer Object for AML screening operations, used for API input/output and Nintex SmartObject generation"
		},
		"CoreAccount": {
			"type": "object",
			"required": ["accountType", "cif", "currency"],
			"properties": {
				"accountNumber": {
					"type": "string",
					"maxLength": 20,
					"minLength": 0,
					"example": "1234567890",
					"description": "Unique account number"
				},
				"cif": {
					"type": "integer",
					"format": "int64",
					"description": "Customer Information File number"
				},
				"customer": {
					"$ref": "#/definitions/CoreCustomer",
					"description": "Reference to the associated customer"
				},
				"accountType": {
					"type": "string",
					"maxLength": 30,
					"minLength": 0,
					"enum": ["savings", "current", "fixed_deposit", "loan"],
					"description": "Type of account"
				},
				"currency": {
					"type": "string",
					"maxLength": 3,
					"minLength": 3,
					"example": "USD",
					"description": "Currency code"
				},
				"debitBlocked": {
					"type": "boolean",
					"default": false,
					"description": "Indicates if debit is blocked"
				},
				"productCode": {
					"type": "string",
					"maxLength": 30,
					"minLength": 0,
					"description": "Product code for the account"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time",
					"description": "Timestamp of account creation"
				}
			},
			"xml": {
				"name": "CoreAccount"
			}
		},
		"CoreAccountDTO": {
			"type": "object",
			"required": ["accountType", "cif", "currency"],
			"properties": {
				"accountNumber": {
					"type": "string",
					"maxLength": 20,
					"minLength": 0,
					"example": "1234567890",
					"description": "Unique account number"
				},
				"cif": {
					"type": "integer",
					"format": "int64",
					"description": "Customer Information File number"
				},
				"accountType": {
					"type": "string",
					"maxLength": 30,
					"minLength": 0,
					"enum": ["savings", "current", "fixed_deposit", "loan"],
					"description": "Type of account"
				},
				"currency": {
					"type": "string",
					"maxLength": 3,
					"minLength": 3,
					"example": "USD",
					"description": "Currency code"
				},
				"debitBlocked": {
					"type": "boolean",
					"default": false,
					"description": "Indicates if debit is blocked"
				},
				"productCode": {
					"type": "string",
					"maxLength": 30,
					"minLength": 0,
					"description": "Product code for the account"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time",
					"description": "Timestamp of account creation"
				},
				"customer": {
					"$ref": "#/definitions/CoreCustomerDTO",
					"description": "Reference to the associated customer DTO"
				}
			},
			"xml": {
				"name": "CoreAccountDTO"
			},
			"description": "Data Transfer Object for account operations, used for API input/output and Nintex SmartObject generation"
		},
		"CoreCustomer": {
			"type": "object",
			"required": ["branchCode", "dob", "gender", "mobile", "nameAr"],
			"properties": {
				"cif": {
					"type": "integer",
					"format": "int64",
					"example": 0,
					"description": "Customer Information File number (optional, set to 0 if not assigned)"
				},
				"nationalID": {
					"type": "string",
					"maxLength": 14,
					"minLength": 0,
					"example": "12345678901234",
					"description": "National ID of the customer"
				},
				"passportNo": {
					"type": "string",
					"maxLength": 30,
					"minLength": 0,
					"example": "0680645",
					"description": "Passport number of the customer"
				},
				"nameAr": {
					"type": "string",
					"maxLength": 200,
					"minLength": 1,
					"example": "محمد أحمد",
					"description": "Customer name in Arabic"
				},
				"nameEn": {
					"type": "string",
					"maxLength": 200,
					"minLength": 0,
					"example": "Mohamed Ahmed",
					"description": "Customer name in English"
				},
				"dob": {
					"type": "string",
					"format": "date",
					"example": "1990-01-01",
					"description": "Date of birth (YYYY-MM-DD)"
				},
				"gender": {
					"type": "string",
					"enum": ["M", "F"],
					"example": "male",
					"description": "Gender of the customer (male or female)"
				},
				"address": {
					"type": "string",
					"maxLength": 400,
					"minLength": 0,
					"example": "123 Main St, City",
					"description": "Customer address"
				},
				"mobile": {
					"type": "string",
					"maxLength": 20,
					"minLength": 1,
					"example": "+201234567890",
					"description": "Customer mobile number"
				},
				"email": {
					"type": "string",
					"maxLength": 200,
					"minLength": 0,
					"format": "email",
					"example": "mohammed@example.com",
					"description": "Customer email address"
				},
				"branchCode": {
					"type": "string",
					"maxLength": 10,
					"minLength": 1,
					"example": "BR001",
					"description": "Branch code"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time",
					"example": "2025-08-20T11:38:45.184Z",
					"description": "Creation timestamp (optional, typically set by the server)"
				},
				"accounts": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/CoreAccount"
					},
					"description": "List of accounts associated with the customer"
				}
			},
			"xml": {
				"name": "CoreCustomer"
			}
		},
		"CoreCustomerDTO": {
			"type": "object",
			"required": ["branchCode", "dob", "gender", "mobile", "nameAr"],
			"properties": {
				"cif": {
					"type": "integer",
					"format": "int64",
					"example": 0,
					"description": "Customer Information File number (optional, set to 0 if not assigned)"
				},
				"nationalID": {
					"type": "string",
					"maxLength": 14,
					"minLength": 0,
					"example": "12345678901234",
					"description": "National ID of the customer"
				},
				"passportNo": {
					"type": "string",
					"maxLength": 30,
