					"405": {
						"description": "Validation exception",
						"schema": {
							"$ref": "#/definitions/Error"
						}
					}
				},
				"security": [
					{
						"banking_auth": ["write:accounts", "read:accounts"]
					}
				]
			}
		},
		"/CoreCustomer": {
			"post": {
				"tags": ["customer"],
				"x-k2-entityName": "CoreCustomerDTO",
				"x-k2-displayName": "Create Customer",
				"x-k2-description": "Creates a new customer in the system using CoreCustomerDTO. This method is associated with CoreCustomerDTO for Nintex SmartObject generation, ensuring data is passed to the API as a DTO.",
				"summary": "Create customer",
				"description": "Register a new customer using CoreCustomerDTO for data transfer to the API. This endpoint creates a new customer and is associated with CoreCustomerDTO for Nintex SmartObject generation.",
				"operationId": "createCustomer",
				"consumes": ["application/json"],
				"produces": ["application/json"],
				"parameters": [
					{
						"in": "body",
						"name": "body",
						"description": "Customer DTO object to create",
						"required": true,
						"schema": {
							"$ref": "#/definitions/CoreCustomerDTO"
						}
					}
				],
				"responses": {
					"201": {
						"description": "Customer created successfully",
						"schema": {
							"$ref": "#/definitions/CoreCustomerDTO"
						}
					},
					"400": {
						"description": "Invalid input",
						"schema": {
							"$ref": "#/definitions/Error"
						}
					}
				},
				"security": [
					{
						"banking_auth": ["write:customers"]
					}
				]
			}
		},
		"/Ecm/Folders": {
			"post": {
				"tags": ["document"],
				"x-k2-entityName": "EcmFolderDTO",
				"x-k2-displayName": "Create Folder",
				"x-k2-description": "Creates a new document folder using EcmFolderDTO. This method is associated with EcmFolderDTO for Nintex SmartObject generation, ensuring data is passed to the API as a DTO.",
				"summary": "Create a new folder",
				"description": "Create a document folder using EcmFolderDTO for data transfer to the API. This endpoint creates a new folder and is associated with EcmFolderDTO for Nintex SmartObject generation.",
				"operationId": "createFolder",
				"consumes": ["application/json"],
				"produces": ["application/json"],
				"parameters": [
					{
						"in": "body",
						"name": "body",
