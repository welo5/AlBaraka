{
  "paths": {
    "/CoreCustomer": {
      "post": {
        "tags": ["customer"],
        "summary": "Create customer",
        "description": "Register a new customer",
        "operationId": "createCustomer",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Customer object to create",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["customer"],
              "properties": {
                "customer": {
                  "$ref": "#/definitions/CoreCustomerInput"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "schema": {
              "$ref": "#/definitions/CoreCustomer"
            }
          },
          "400": {
            "description": "Invalid input"
          }
        },
        "security": [
          {
            "banking_auth": ["write:customers"]
          }
        ]
      }
    }
  },
  "definitions": {
    "CoreCustomerInput": {
      "type": "object",
      "required": ["nameAr", "dob", "gender", "mobile", "branchCode"],
      "properties": {
        "cif": {
          "type": "integer",
          "format": "int64",
          "example": 0,
          "description": "Customer Information File number (optional, set to 0 if not assigned)"
        },
        "nationalID": {
          "type": "string",
          "maxLength": 14,
          "minLength": 0,
          "example": "1736536521234",
          "description": "National ID of the customer"
        },
        "passportNo": {
          "type": "string",
          "maxLength": 30,
          "minLength": 0,
          "example": "0680645",
          "description": "Passport number of the customer"
        },
        "nameAr": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "example": "string",
          "description": "Customer name in Arabic"
        },
        "nameEn": {
          "type": "string",
          "maxLength": 200,
          "minLength": 0,
          "example": "string",
          "description": "Customer name in English"
        },
        "dob": {
          "type": "string",
          "format": "date",
          "example": "2025-08-20",
          "description": "Date of birth (YYYY-MM-DD)"
        },
        "gender": {
          "type": "string",
          "enum": ["M", "F"],
          "example": "M",
          "description": "Gender of the customer (M or F)"
        },
        "address": {
          "type": "string",
          "maxLength": 400,
          "minLength": 0,
          "example": "string",
          "description": "Customer address"
        },
        "mobile": {
          "type": "string",
          "maxLength": 20,
          "minLength": 1,
          "example": "string",
          "description": "Customer mobile number"
        },
        "email": {
          "type": "string",
          "maxLength": 200,
          "minLength": 0,
          "format": "email",
          "example": "use368@example.com",
          "description": "Customer email address"
        },
        "branchCode": {
          "type": "string",
          "maxLength": 10,
          "minLength": 1,
          "example": "string",
          "description": "Branch code"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "example": "2025-08-20T11:38:45.184Z",
          "description": "Creation timestamp (optional, typically set by the server)"
        }
      },
      "xml": {
        "name": "CoreCustomerInput"
      }
    },
    "CoreCustomer": {
      "type": "object",
