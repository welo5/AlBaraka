"CoreCustomerInput": {
  "type": "object",
  "required": ["cif", "nameAr", "dob", "gender", "mobile", "branchCode"],
  "properties": {
    "cif": {
      "type": "integer",
      "format": "int64",
      "example": 1000000099,
      "description": "Customer Information File number"
    },
    "nationalID": {
      "type": "string",
      "maxLength": 14,
      "minLength": 1,
      "example": "12345678912345",
      "description": "National ID of the customer"
    },
    "passportNo": {
      "type": "string",
      "maxLength": 30,
      "minLength": 1,
      "example": "12345",
      "description": "Passport number of the customer"
    },
    "nameAr": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1,
      "example": "يبلات",
      "description": "Customer name in Arabic"
    },
    "nameEn": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1,
      "example": "welo",
      "description": "Customer name in English"
    },
    "dob": {
      "type": "string",
      "format": "date",
      "example": "2000-10-16",
      "description": "Date of birth (YYYY-MM-DD)"
    },
    "gender": {
      "type": "string",
      "enum": ["M", "F"],
      "example": "M",
      "description": "Gender of the customer (M or F)"
    },
    "address": {
      "type": "string",
      "maxLength": 400,
      "minLength": 1,
      "example": "djk",
      "description": "Customer address"
    },
    "mobile": {
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "example": "01119994851",
      "description": "Customer mobile number"
    },
    "email": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1,
      "format": "email",
      "example": "aaa@gmail.com",
      "description": "Customer email address"
    },
    "branchCode": {
      "type": "string",
      "maxLength": 10,
      "minLength": 1,
      "example": "EGY",
      "description": "Branch code"
    }
  },
  "xml": {
    "name": "CoreCustomerInput"
  }
}
